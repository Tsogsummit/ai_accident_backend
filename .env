ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ==========================================
# AI Detection
# ==========================================
AI_CONFIDENCE_THRESHOLD=0.5
AI_MIN_ACCIDENT_FRAME_RATIO=0.3
AI_FRAME_INTERVAL=0.1

NOTIFICATION_DEFAULT_RADIUS=5000

